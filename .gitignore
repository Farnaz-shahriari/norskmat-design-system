.DS_Store
node_modules/
*.tgz
_to_delete/

# Reference site build output. Generated by npm run docs and deployed by
# .github/workflows/docs.yml on every push to main. Do not commit these,
# a committed copy is a copy that can lag behind the design system.
docs/index.html
docs/tokens.json
docs/audit.js
docs/artifact.html

# Package build output, produced by npm run build.
dist/

# Storybook build output and logs, produced by npm run build-storybook.
storybook-static/
*storybook.log

# /design-sync working state. The durable sync inputs, .design-sync/config.json,
# NOTES.md, conventions.md, previews/ and overrides/, are committed.
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.ds-sync/
ds-bundle/
