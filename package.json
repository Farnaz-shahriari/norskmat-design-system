{
  "name": "@norskmat/design-system",
  "version": "1.0.0",
  "description": "Norsk Mat design system, canonical tokens and component library for KSL, Nyt Norge, Spesialitet, LokalMat, Beskyttede Betegnelser, and Stiftelsen Norsk Mat.",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Farnaz-shahriari/norskmat-design-system.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./dist/norskmat.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./source.css": "./src/styles/index.css",
    "./components/*": "./src/components/*.tsx",
    "./utils": "./src/components/utils.ts",
    "./logos/*": "./skills/norsk-mat-design-system/assets/*"
  },
  "files": [
    "src",
    "dist",
    "skills",
    "docs",
    ".claude-plugin"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:barrel && npm run build:css && npm run build:types",
    "build:barrel": "node scripts/build-barrel.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "docs": "node scripts/build-docs.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-hook-form": "7.55.0",
    "react-resizable-panels": "2.1.7",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "^3.0.2",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.11"
  }
}
